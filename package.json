{
  "name": "wealthtrack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/main.mjs",
    "start": "node src/main.mjs",
    "test": "node --test",
    "test:cov": "c8 --all --include=\"src/**/*.mjs\" --exclude=\"src/**/*.test.mjs\" --exclude=\"src/main.mjs\" --check-coverage --lines 90 --branches 90 --functions 90 --statements 90 --reporter=text npm test",
    "check": "node --check src/main.mjs && node --check src/server.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.mjs\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"openapi.yaml\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"openapi.yaml\""
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
